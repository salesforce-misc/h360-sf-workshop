# Dev-only: makes the Agentforce chat (ACC) work on localhost (`sf ui-bundle dev`).
# Localhost has no Salesforce session, so ACC needs a frontdoorUrl instead of salesforceOrigin.
# Mint a fresh OTP-backed URL from your CLI session (it is short-lived — refresh per session):
#   sf org open --target-org h360-orgfarm-test --url-only
# Copy the printed https://...frontdoor.jsp?otp=... URL here, then run `sf ui-bundle dev`.
# NEVER commit the real .env.local — it embeds a live session token. (.env.local is gitignored.)
VITE_SF_FRONTDOOR_URL=

# The org's Agentforce agent (Headless360_Order_Assistant) BotDefinition Id.
# PER-ORG value — do NOT hardcode; auto-populate from your target org before build:
#   sf data query -o <alias> -q "SELECT Id FROM BotDefinition WHERE DeveloperName='Headless360_Order_Assistant'" --json \
#     | python3 -c 'import sys,json;print("VITE_AGENT_ID="+json.load(sys.stdin)["result"]["records"][0]["Id"])' >> .env.local
VITE_AGENT_ID=
