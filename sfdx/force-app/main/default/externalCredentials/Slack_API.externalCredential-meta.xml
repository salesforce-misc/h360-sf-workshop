<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Slack API</label>
    <!-- Custom protocol + a bearer AuthHeader that injects the Slack BOT token (xoxb-) directly.
         Slack's OAuth v2 bot flow returns no id_token, so an OIDC Auth Provider fails its identity
         step ("We can't log you in…"). Bot tokens are long-lived and authenticate via
         `Authorization: Bearer xoxb-…`, so no OAuth browser flow / Auth Provider is needed.

         🔴 CRITICAL NAMING: the NamedPrincipal parameter (Slack_Bot_Principal) only DECLARES the
         principal identity — it holds no value and is NOT a merge-field source. The token value lives
         in a SEPARATE custom authentication parameter named `BotToken`, which is what the AuthHeader
         references. Do NOT reuse one name for both (that makes {!$Credential...} resolve to empty →
         Slack invalid_auth). Verified against working Slack/OpenAI configs 2026-07-23.

         PER-ORG after deploy: Setup → Named Credentials → External Credentials → Slack API →
         Principals → edit `Slack_Bot_Principal` → Authentication Parameters → add Name=`BotToken`,
         Value=<xoxb- token> (no "Bearer" prefix). Secrets are NOT committed. See GUIDE M4. -->
    <authenticationProtocol>Custom</authenticationProtocol>
    <externalCredentialParameters>
        <parameterGroup>Slack_Bot_Principal</parameterGroup>
        <parameterName>Slack_Bot_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>Bearer {!$Credential.Slack_API.BotToken}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
</ExternalCredential>
