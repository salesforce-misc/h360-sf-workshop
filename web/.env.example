# Browser-exposed (VITE_ prefix → bundled into the React app):
VITE_SF_MYDOMAIN=https://<your-domain>.my.salesforce.com
VITE_AGENT_ID=
VITE_CLIENT_ID=
VITE_ACCESS_TOKEN=
# Optional: link the HXL side to the in-org HXL Widget Viewer. Set ONLY if you've deployed the
# viewer (scripts/08-deploy-hxl-widget-viewer.sh — see Module 4 §4c). Empty → the footer link is hidden.
# Full URL, or a path prefixed with VITE_SF_MYDOMAIN, e.g. /lightning/n/HXL_Widget_Viewer
VITE_HXL_VIEWER_URL=

# Server-only — the proxy reads these; NOT VITE_-prefixed on purpose, so Vite never ships them
# to the browser. Paste a fresh Consumer Secret; the access token is minted per session.
SF_CLIENT_SECRET=          # Agent-API ECA consumer secret (pairs with VITE_CLIENT_ID)
SLACK_BOT_TOKEN=           # xoxb-… bot token (optional; enables the Slack auth.test check)
ORG_ALIAS=h360-orgfarm-test
